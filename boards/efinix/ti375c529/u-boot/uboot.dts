/dts-v1/;
#include <config.h>
/include/ "sapphire.dtsi"

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "efinix,sapphire";

	
	memory {
		device_type = "memory";
		reg = <0x400000 0x3fc00000>;
	};
	
		
        chosen {
        	stdout-path = "serial0:115200n8";
        	bootargs = "console=ttyS0,115200n8";
        };
		
        aliases {
        	serial0 = &uart0;
        	spi0 = &spi0;
        };
	
	

        wdt-reboot {
        	compatible = "wdt-reboot";
        	clock-frequency = <200000000>;
        	wdt = <&watchdog0>;
        	status = "okay";
        };


};
&plic {
	device_type = "interrupt-controller";
	compatible = "sifive,plic-1.0.0";
	#interrupt-cells = <2>;
	riscv,ndev = <32>;
	status = "okay";
};

&clint0 {
	compatible = "riscv,clint0";
	status = "okay";
};


&uart1 {
	device_type = "serial";
	compatible = "riscv_sbi,uart";
	status = "okay";
};

&uart2 {
	device_type = "serial";
	compatible = "riscv_sbi,uart";
	status = "okay";
};

&uart0 {
	device_type = "serial";
	compatible = "riscv_sbi,uart";
	status = "okay";
};

&spi2 {
	compatible = "vexriscv,spi";
	status = "okay";
};

&spi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	compatible = "vexriscv,spi";
	status = "okay";
	
        flash0: flash@0 {
                status = "okay";
        	reg = <0>;
        	compatible = "jedec,spi-nor";
        	spi-max-frequency = <6000000>;
        	disable-auto-4byte-addressing;
        };
};

&spi1 {
	compatible = "vexriscv,spi";
	status = "okay";
};

&watchdog0 {
	compatible = "efx,efx-wdt";
	status = "okay";
};

