#!/bin/sh
# Load the FCU remoteproc driver. The FCU is held from reset; with
# stalya,auto-boot in the device tree the driver loads the firmware and starts
# it. See /sys/class/remoteproc/remoteproc0/{state,firmware}.
case "$1" in
start)
	printf "Loading fcu_rproc: "
	modprobe fcu_rproc && echo "OK" || echo "FAIL"
	;;
stop)
	# Unloading leaves the FCU running.
	modprobe -r fcu_rproc
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
