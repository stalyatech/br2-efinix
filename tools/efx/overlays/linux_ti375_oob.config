# ti375_oob — hand-authored kernel config overrides.
#
# Merged after boards/efinix/common/kernel/*.config and the board's
# linux.config, so everything here wins.
#
# Values derived from soc.h are generated into state/linux_derived.config
# instead, so they cannot drift from the hardware description.

# Console. The Spinal UART driver registers as ttySL*; earlycon picks the node
# up from the device tree, so no address is hard-coded here.
CONFIG_SERIAL_EARLYCON=y

# Keep the kernel honest about what the hardware actually provides: the hard SoC
# has no Zicbom and no hardware performance counters wired to the PLIC.
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_PMU_SBI is not set

# Useful while bringing up a board that has no storage yet.
CONFIG_PRINTK_TIME=y
CONFIG_DEVTMPFS_MOUNT=y

# Linux loads, starts and stops the soft FCU SoC (fcu_rproc, ti375_oob
# sw/linux/fcu_rproc).
CONFIG_REMOTEPROC=y

# /dev/mem may reach RAM and devices no driver has claimed, nothing else. The
# NPU is a bus master with no address filter and amp_ctrl holds the FCU's
# reset: both are reached through their drivers only.
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# Ethernet: the gTSE MAC with the gDMA engine, and the RTL8211F PHY on the
# board (ti375_oob-linux.dtsi describes both).
CONFIG_NET_VENDOR_EFINIX=y
CONFIG_EFINIX_TSEMAC=y
CONFIG_REALTEK_PHY=y

# rpmsg over the FCU's vrings: the virtio transport and the tty channels PX4
# and Linux talk over (fcu_rproc provides the kick and the vring interrupt).
CONFIG_RPMSG=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_TTY=y

# The second SPI flash carries the FCU firmware (and later parameters and
# logs) in a filesystem Linux can write, so updating it is a file copy.
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_FS_WRITEBUFFER=y
