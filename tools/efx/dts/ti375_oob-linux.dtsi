// SPDX-License-Identifier: GPL-2.0
/*
 * ti375_oob: devices of the Linux hard SoC that the generator cannot describe.
 *
 * efx config includes it at the end of the generated
 * boards/efinix/ti375c529/linux/linux.dts and copies it next to it for the
 * kernel build (BR2_LINUX_KERNEL_CUSTOM_DTS_PATH).
 *
 * DDR, all no-map: Linux never touches these ranges, and nothing but the
 * owning driver maps them.
 *
 *   0x1E00_0000  32 MiB   FCU firmware (PX4 on NuttX), loaded by remoteproc;
 *                         AMP_FCU_MEM_* in ti375_oob sw/amp/amp_ctrl.h. The
 *                         last 2 MiB are meant for the Linux <-> FCU rpmsg
 *                         buffers once that is added.
 *   0x3800_0000  64 MiB   npu0
 *   0x3C00_0000  64 MiB   npu1
 *
 * NPU blobs are compiled for fixed addresses (rtl/snpu_system.json: npu0
 * 0x2000_0000 / 0x2800_0000, npu1 0x3000_0000 / 0x3800_0000), which Linux now
 * owns; the snpu driver relocates them into these regions at run time. A
 * region has to hold the blob and its scratch; YOLOv8s needs 23 MiB on npu0
 * and 34 MiB on npu1. The last MiB of each is the driver's descriptor area.
 */

/ {
	aliases {
		npu0 = &npu0;
		npu1 = &npu1;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		fcu_mem: fcu@1e000000 {
			reg = <0x1e000000 0x02000000>;
			no-map;
		};

		npu0_mem: npu0@38000000 {
			reg = <0x38000000 0x04000000>;
			no-map;
		};

		npu1_mem: npu1@3c000000 {
			reg = <0x3c000000 0x04000000>;
			no-map;
		};
	};

	/* StalyaNPU 32x16, CSR block on the hard SoC APB window, PLIC 9 */
	npu0: npu@e8104000 {
		compatible = "stalya,snpu";
		reg = <0xe8104000 0x100>;
		interrupt-parent = <&plic>;
		interrupts = <9>;
		memory-region = <&npu0_mem>;
	};

	/* StalyaNPU 16x8, PLIC 10 */
	npu1: npu@e8104100 {
		compatible = "stalya,snpu";
		reg = <0xe8104100 0x100>;
		interrupt-parent = <&plic>;
		interrupts = <10>;
		memory-region = <&npu1_mem>;
	};

	/*
	 * Soft FCU SoC through amp_ctrl; doorbell from the FCU on PLIC 11. The
	 * FCU is held from reset until this driver starts it: with auto-boot it
	 * loads /lib/firmware/<firmware-name> and starts it when it probes.
	 */
	/*
	 * gDMA (SpinalHDL dmasg) moves the Ethernet frames. It sits in the
	 * lowest 16 KiB of the hard SoC's APB window; the rest of that window
	 * belongs to the NPU (+0x4000) and amp_ctrl (+0x8000), so only its own
	 * 16 KiB are claimed here. Channel 0 is receive, channel 1 transmit
	 * (rtl/ti375_oob_top.v, dma_interrupts -> userInterruptG/H = PLIC 7/8).
	 */
	eth_dma: dma@e8100000 {
		compatible = "spinal,lib-dmasg";
		reg = <0xe8100000 0x4000>;
		interrupt-parent = <&plic>;
		interrupts = <7>, <8>;		/* [0] rx, [1] tx */
		#dma-cells = <1>;
		axistream-connected = <&tsemac0>;
		axistream-control-connected = <&tsemac0>;
	};

	/*
	 * gTSE, the Ethernet MAC, on AXI slave 0 of the hard SoC (16 MiB
	 * window, of which the driver touches the MAC at 0x000, the MDIO bus
	 * at 0x100 and the control block at 0x200).
	 *
	 * The RGMII delays are made in the fabric (TX clock shifted 90
	 * degrees, RX resynchronised per bit), so the PHY must not add its
	 * own: the mode is plain "rgmii". The PHY reset is a control register
	 * of the MAC, not a GPIO, and the driver drives it.
	 */
	tsemac0: ethernet@ea000000 {
		compatible = "efinix,tsemac-0.01.a";
		device_type = "network";
		reg = <0xea000000 0x1000>;
		axistream-connected = <&eth_dma>;
		axistream-control-connected = <&eth_dma>;
		phy-mode = "rgmii";
		phy-handle = <&ethphy0>;
		local-mac-address = [ 02 53 54 41 4c 59 ];
		efx,rxcsum = <0x0>;
		efx,txcsum = <0x0>;
		efx,rxmem = <0x1000>;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * RTL8211F at MDIO address 0. The RX path of this
			 * bitstream is wired to the gigabit receive clock
			 * only (ETH_1000MBPS in the top level), so the link
			 * has to come up at 1000FD.
			 */
			ethphy0: ethernet-phy@0 {
				compatible = "ethernet-phy-id001c.c916";
				reg = <0>;
				max-speed = <1000>;
				reset-assert-us = <500000>;
				reset-deassert-us = <500000>;
			};
		};
	};

	fcu: fcu@e8108000 {
		compatible = "stalya,fcu-rproc";
		reg = <0xe8108000 0x40>;
		interrupt-parent = <&plic>;
		interrupts = <11>;
		memory-region = <&fcu_mem>;
		firmware-name = "px4_fcu.elf";
		stalya,auto-boot;
	};
};

/*
 * The SD card-detect interrupt never reaches Linux on this design: a card put
 * in after boot stays unseen until the host is rebound. Poll for it instead
 * (mmc core checks once a second).
 */
&mmc0 {
	broken-cd;
};

/*
 * The board carries two IS25WP512M flashes on the hard SoC's SPI buses. SPI0
 * is the one the FPGA configures from and the one the boot image is written
 * to over JTAG, all inside the first 16 MiB that 3 byte addressing reaches.
 * SPI1 is plain storage (ti375_oob_top.v: the two controllers share the SCLK
 * pin, which is why both belong to the hard SoC and only one of them may be
 * busy at a time).
 *
 * The FCU firmware lives here rather than in the kernel's initramfs: it is
 * the file that changes most often, and writing it costs a file copy instead
 * of a flash image and a reset.
 */
&spi1 {
	#address-cells = <1>;
	#size-cells = <0>;

	storage: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				reg = <0x0 0x800000>;	/* 8 MiB */
				label = "fcu_firmware";
			};

			partition@800000 {
				reg = <0x800000 0x3800000>;	/* 56 MiB */
				label = "data";
			};
		};
	};
};
