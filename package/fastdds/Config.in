comment "fastdds needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS

config BR2_PACKAGE_FASTDDS
	bool "fastdds"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_ASIO
	select BR2_PACKAGE_FASTCDR
	select BR2_PACKAGE_FOONATHAN_MEMORY
	select BR2_PACKAGE_TINYXML2_V10
	help
	  eProsima Fast DDS is an implementation of the DDS standard.

	  https://github.com/eProsima/Fast-DDS
